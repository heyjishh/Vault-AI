# Copy to .env (or export) and fill in. Only JWT secret is required to boot.
# (deploy.sh / docker compose create .env for you and generate the secret.)

# Server
LEGAL_RAG_ADDR=127.0.0.1:3000
# Host port when running under docker compose (container always uses 3000).
LEGAL_RAG_PORT=3000
LEGAL_RAG_JWT_SECRET=change-me-to-a-long-random-secret
LEGAL_RAG_JWT_ACCESS_TTL=900
LEGAL_RAG_JWT_REFRESH_TTL=2592000
# Comma-separated emails promoted to admin (Command Center access) at
# register/login.
LEGAL_RAG_ADMIN_EMAILS=

# Vault: S3 source for legal documents (leave unset for upload-only mode)
LEGAL_RAG_S3_BUCKET=
LEGAL_RAG_S3_REGION=
LEGAL_RAG_S3_PREFIX=
# AWS credentials come from the standard chain: env AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY, ~/.aws/credentials, or instance role.

# Embeddings (OpenAI-compatible /embeddings endpoint)
LEGAL_RAG_EMBEDDING_URL=http://localhost:11434/v1/embeddings
LEGAL_RAG_EMBEDDING_API_KEY=
LEGAL_RAG_EMBEDDING_MODEL=nomic-embed-text
LEGAL_RAG_EMBEDDING_DIMS=768

# LLM (OpenAI-compatible /chat/completions endpoint)
LEGAL_RAG_LLM_URL=http://localhost:11434/v1/chat/completions
LEGAL_RAG_LLM_API_KEY=
LEGAL_RAG_LLM_MODEL=llama3.1

# ── Quick start: Cloudflare Workers AI (the configuration we run) ──────────
# Replace the three URL/key/model blocks above with:
#   LEGAL_RAG_LLM_URL=https://api.cloudflare.com/client/v4/accounts/<your-account-id>/ai/v1/chat/completions
#   LEGAL_RAG_LLM_API_KEY=<your-api-token>
#   LEGAL_RAG_LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
#   LEGAL_RAG_EMBEDDING_URL=https://api.cloudflare.com/client/v4/accounts/<your-account-id>/ai/v1/embeddings
#   LEGAL_RAG_EMBEDDING_API_KEY=<your-api-token>
#   LEGAL_RAG_EMBEDDING_MODEL=@cf/baai/bge-m3
#   LEGAL_RAG_EMBEDDING_DIMS=1024
# bge-m3 is multilingual (Hindi question ↔ English statute ≈ 0.89 cosine).

# OIDC login wall (Auth0-compatible). Unset = local JWT auth only.
LEGAL_RAG_OIDC_ISSUER=https://<tenant>.us.auth0.com
LEGAL_RAG_OIDC_CLIENT_ID=
LEGAL_RAG_OIDC_CLIENT_SECRET=
LEGAL_RAG_OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback

# Chunking
LEGAL_RAG_CHUNK_SIZE=1200
LEGAL_RAG_CHUNK_OVERLAP=200

# Vector store: SereneDB (Postgres wire protocol, port 7890). Unset = in-memory index.
# Run: docker run -d --name serenedb -p 7890:7890 serenedb/serenedb
SERENEDB_URL=postgres://postgres@127.0.0.1:7890/postgres
SERENEDB_TABLE=legal_chunks

# RAG-Anything pipeline tuning
RAG_ANYTHING_MAX_CONCURRENT_FILES=4
RAG_ANYTHING_ENABLE_IMAGE_PROCESSING=1
RAG_ANYTHING_ENABLE_TABLE_PROCESSING=1
RAG_ANYTHING_ENABLE_EQUATION_PROCESSING=1

# PDF OCR fallback (scanned/image PDFs): text layer first, then pdftoppm
# renders each sparse page and Surya recognizes it.
# Benchmark (2026-10-20): Surya tied Tesseract on English prose (0.00% CER)
# and beat it on Hindi (0.00 vs 0.86), ruled tables (0.80 vs 49.9) and a
# real 1947 Gazette page (6.66 vs 7.8) — so there is no Tesseract tier,
# and no second-engine fallback: Surya is the only OCR engine.
RAG_ANYTHING_OCR_ENABLED=1
RAG_ANYTHING_OCR_MIN_TEXT_CHARS=50
RAG_ANYTHING_OCR_DPI=300
# Engine command: reads a PNG on stdin, writes text on stdout. The sidecar
# script ships in tools/ocr/; its Python deps (surya-ocr) must be installed
# in the python used here, or point the command at your own OCR service.
# Empty = OCR skipped (text layer only).
RAG_ANYTHING_OCR_PRIMARY_CMD=python3 /app/tools/ocr/surya_sidecar.py

# Reranking of retrieved candidates. Default decision layer is the local
# cross-encoder service (zero billable tokens/query); the LLM listwise
# reranker remains as LEGAL_RAG_RERANKER=llm (deep judge). Disable with 0.
LEGAL_RAG_RERANK=1
LEGAL_RAG_RERANK_CANDIDATES=20
LEGAL_RAG_RERANKER=local
# Run: RERANK_PORT=8081 python3 tools/rerank/bge_reranker_sidecar.py
LEGAL_RAG_RERANK_URL=http://127.0.0.1:8081/rerank

# Development: deterministic mock embeddings + LLM (no external calls)
LEGAL_RAG_USE_MOCK_PROVIDERS=0

# Semantic cache (application-level KV cache for LLM + embeddings).
# Disable with 0.
LEGAL_RAG_CACHE_ENABLED=1

# Web search via the invisible_playwright stealth sidecar (tools/web).
# Disable with 0. LEGAL_RAG_WEB_SIDECAR overrides the sidecar directory.
LEGAL_RAG_WEB_SEARCH=1
# LEGAL_RAG_WEB_SIDECAR=tools/web

# Persistence: snapshots of chunks, graph, document registry, and users.
# Saved every 5 minutes and on graceful shutdown; restored on boot.
# SereneDB (when configured) persists vectors itself and skips snapshots.
LEGAL_RAG_DATA_DIR=./data
